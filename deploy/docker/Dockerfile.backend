# =========================================================
# Stage 1: Build & Dependencies
# =========================================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Install build dependencies for C-extensions (asyncpg, pgvector, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# =========================================================
# Stage 2: Minimal Production Runtime
# =========================================================
FROM python:3.12-slim AS runner

WORKDIR /app

# Install libpq for PostgreSQL client connectivity
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed python wheels from builder
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Create non-root system user for security
RUN groupadd -r cosmos && useradd -r -g cosmos -s /bin/false cosmos

# Copy application source code and migrations
COPY . /app
RUN chown -R cosmos:cosmos /app

USER cosmos

EXPOSE 8000

# Production ASGI server with uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]
